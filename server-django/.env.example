# Copy to .env and adjust. Everything here has a sensible default for local development.

DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.trycloudflare.com
CORS_ORIGIN=http://localhost:5173

# PostgreSQL (local). A separate database from the Node version.
DB_NAME=srm_django
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# Hosted database instead (replaces the DB_* values above):
# DATABASE_URL=postgres://user:password@host/dbname
# DB_SSL=true

# Redis (docker compose up -d redis). Database 1 = cache, database 2 = Celery.
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-to-another-long-random-string
JWT_EXPIRES_SECONDS=3600
LOGIN_RATE_LIMIT_MAX=10
TRUST_PROXY=0

DASHBOARD_CACHE_TTL_SECONDS=60
OVERDUE_CHECK_INTERVAL_SECONDS=60

# Swagger UI at /api-docs/ is protected with these (required when DJANGO_DEBUG=false)
SWAGGER_USER=apidocs
SWAGGER_PASS=ApiDocs@12345

# Demo users created by `python manage.py seed_demo` (development only; these are the defaults)
# SEED_ADMIN_EMAIL=admin@company.com
# SEED_ADMIN_PASSWORD=Admin@12345
# SEED_EMPLOYEE_EMAIL=employee@company.com
# SEED_EMPLOYEE_PASSWORD=Employee@12345
