# Overview of every environment variable used by the project.
# Copy server/.env.example -> server/.env and client/.env.example -> client/.env.

# --- server ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL (local install). Leave DB_PASSWORD empty if your local user has no password.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=service_requests
DB_USER=postgres
DB_PASSWORD=

# Redis (docker compose up -d redis)
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth (used from Phase 3)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h
# Login attempts allowed per IP per 15 minutes
LOGIN_RATE_LIMIT_MAX=10

# Overdue worker: how often it checks (ms), and how long the dashboard summary stays cached (seconds)
OVERDUE_CHECK_INTERVAL_MS=60000
DASHBOARD_CACHE_TTL_SECONDS=60

# Basic-auth credentials for the Swagger UI at /api-docs (set your own in production)
SWAGGER_USER=apidocs
SWAGGER_PASS=ApiDocs@12345

# --- client ---
VITE_API_BASE_URL=/api/v1

# Demo users created by `npm run db:seed` (development only; defaults shown)
# SEED_ADMIN_EMAIL=admin@company.com
# SEED_ADMIN_PASSWORD=Admin@12345
# SEED_EMPLOYEE_EMAIL=employee@company.com
# SEED_EMPLOYEE_PASSWORD=Employee@12345

# --- Hosted / Vercel settings (all optional locally; see docs/deploy-to-vercel.html) ---
# DATABASE_URL=postgres://user:password@host/dbname     # hosted PostgreSQL (Neon). Replaces DB_HOST/PORT/NAME/USER/PASSWORD
# DB_SSL=true                                           # required by most hosted databases
# DB_POOL_MAX=2                                         # keep small on serverless
# REDIS_URL=rediss://default:password@host:6379         # hosted Redis (Upstash). Replaces REDIS_HOST/PORT
# TRUST_PROXY=1                                         # 1 when behind Vercel's proxy (correct client IP for rate limiting)
# ENABLE_BULL_BOARD=false                               # no worker / long-lived connection on Vercel
# OVERDUE_ON_DEMAND_SECONDS=60                          # OPTIONAL extra on Vercel: also run the overdue check when the dashboard/list is opened and the last run is older than this (default 0 = daily cron only)
# CRON_SECRET=a-random-string-of-16-or-more-characters  # enables GET /api/v1/internal/cron/overdue-check for schedulers
# BULLMQ_DRAIN_DELAY_SECONDS=5                          # worker polling pace (raise on metered Redis)
